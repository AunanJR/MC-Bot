# Copy to .env and adjust. Every value has a default in docker-compose.yml.

# Postgres password for the internal database. Change it for any real deployment.
POSTGRES_PASSWORD=change-me
# If set, every API request needs "Authorization: Bearer <API_TOKEN>".
API_TOKEN=
# Host port for the API.
API_PORT=3000
# Host port for the bundled test Minecraft server.
MC_PORT=25565
# Default bot username (offline mode) and protocol version.
BOT_USERNAME=Blueprint
MC_VERSION=26.1
# Op-mode commands per second (each /fill counts as one).
OP_COMMANDS_PER_SECOND=20
# Sessions one worker builds at the same time.
WORKER_CONCURRENCY=2
