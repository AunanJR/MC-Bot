{
  "name": "blueprint",
  "version": "0.1.0",
  "private": true,
  "description": "Blueprint: a Mineflayer bot that builds .litematic/.schem schematics in op or survival mode",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "bullmq": "^6.3.10",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "ioredis": "^6.0.0",
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "nucleation": "^0.10.24",
    "postgres": "^3.4.9",
    "prismarine-block": "1.23.0",
    "vec3": "^0.1.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
